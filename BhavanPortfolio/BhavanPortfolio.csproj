<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- Tailwind CSS Build Target (skipped in CI - handled by workflow) -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="'$(CI)' != 'true'">
    <Exec Command="./tailwindcss -i ./tailwind-input.css -o ./wwwroot/css/app.css" Condition="'$(Configuration)' == 'Debug'" />
    <Exec Command="./tailwindcss -i ./tailwind-input.css -o ./wwwroot/css/app.css --minify" Condition="'$(Configuration)' == 'Release'" />
  </Target>

</Project>
