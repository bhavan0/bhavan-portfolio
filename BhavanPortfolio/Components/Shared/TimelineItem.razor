@* TimelineItem Component - Single timeline entry for work experience *@
<li class="relative pl-8 pb-8 last:pb-0">
    @* Vertical line connecting entries (AC1: border-l-2 border-gray-700) *@
    <div class="absolute left-0 top-0 bottom-0 border-l-2 border-gray-300 dark:border-gray-700"
         aria-hidden="true"></div>

    @* Dot marker *@
    <div class="absolute left-0 top-1.5 w-3 h-3 -translate-x-1/2 rounded-full
                bg-black dark:bg-white border-2 border-white dark:border-gray-900"
         aria-hidden="true"></div>

    @* Content *@
    <div class="space-y-1">
        @* Period/Date *@
        <time datetime="@DateTimeValue"
              class="text-sm text-gray-600 dark:text-gray-400 font-medium">
            @Period
        </time>

        @* Role Title *@
        <h3 class="text-lg font-semibold text-black dark:text-white">
            @Role
        </h3>

        @* Company Name *@
        <p class="text-base text-gray-600 dark:text-gray-400">
            @Company
        </p>

        @* Description *@
        <p class="text-gray-700 dark:text-gray-300 mt-2 leading-relaxed">
            @Description
        </p>
    </div>
</li>

@code {
    /// <summary>
    /// Time period display text (e.g., "2022 - Present")
    /// </summary>
    [Parameter, EditorRequired]
    public string Period { get; set; } = "";

    /// <summary>
    /// ISO date format for datetime attribute (e.g., "2022-01")
    /// </summary>
    [Parameter, EditorRequired]
    public string DateTimeValue { get; set; } = "";

    /// <summary>
    /// Job title/role name
    /// </summary>
    [Parameter, EditorRequired]
    public string Role { get; set; } = "";

    /// <summary>
    /// Company/organization name
    /// </summary>
    [Parameter, EditorRequired]
    public string Company { get; set; } = "";

    /// <summary>
    /// Brief description of responsibilities/achievements
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = "";
}
