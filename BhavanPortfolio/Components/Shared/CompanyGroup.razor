@* CompanyGroup Component - Groups multiple roles at the same company *@

<li class="relative pl-10 pb-12 last:pb-0 group">
    @* Vertical line connecting to next company *@
    <div class="absolute left-[11px] top-0 bottom-0 w-0.5 bg-gradient-to-b from-gray-300 via-gray-300 to-transparent dark:from-gray-600 dark:via-gray-600"
         aria-hidden="true"></div>

    @* Company dot marker *@
    <div class="absolute left-0 top-1 w-6 h-6 rounded-full flex items-center justify-center
                bg-black dark:bg-white
                shadow-lg ring-4 ring-gray-50 dark:ring-gray-900
                group-hover:scale-110 transition-transform duration-200"
         aria-hidden="true">
        <svg class="w-3 h-3 text-white dark:text-black" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4zm3 1h6v4H7V5zm2 8h2v2H9v-2z" clip-rule="evenodd"/>
        </svg>
    </div>

    @* Company Header *@
    <div class="mb-4">
        <h3 class="text-xl font-bold text-black dark:text-white">
            @CompanyName
        </h3>
    </div>

    @* Nested Roles *@
    <div class="space-y-4">
        @ChildContent
    </div>
</li>

@code {
    /// <summary>
    /// Company/organization name
    /// </summary>
    [Parameter, EditorRequired]
    public string CompanyName { get; set; } = "";

    /// <summary>
    /// Child RoleItem components
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
