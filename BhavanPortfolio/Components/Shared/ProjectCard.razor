<article class="bg-white dark:bg-gray-800 rounded-lg overflow-hidden
               hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
    @* Project Image *@
    <div class="aspect-video overflow-hidden bg-gray-200 dark:bg-gray-700">
        <img src="@ImageUrl" 
             alt="@ImageAlt"
             class="w-full h-full object-cover" />
    </div>
    
    @* Project Content *@
    <div class="p-6">
        <h3 class="text-xl font-semibold text-black dark:text-white">
            @Title
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mt-2 line-clamp-3">
            @Description
        </p>
        
        @* Technology Tags *@
        <div class="flex flex-wrap gap-2 mt-4">
            @foreach (var tech in Technologies)
            {
                <span class="rounded-full px-2 py-1 text-xs font-medium 
                            bg-gray-100 dark:bg-gray-700 
                            text-gray-700 dark:text-gray-300
                            border border-gray-200 dark:border-gray-600">
                    @tech
                </span>
            }
        </div>
        
        @* Action Links *@
        <div class="flex items-center gap-4 mt-4">
            <a href="@GitHubUrl" 
               target="_blank" 
               rel="noopener noreferrer"
               class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white 
                      transition-colors text-sm font-medium
                      focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white 
                      focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800
                      rounded">
                View Code →
            </a>
            @if (!string.IsNullOrEmpty(DemoUrl))
            {
                <a href="@DemoUrl" 
                   target="_blank" 
                   rel="noopener noreferrer"
                   class="text-gray-600 dark:text-gray-400 hover:text-black dark:hover:text-white 
                          transition-colors text-sm font-medium
                          focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white 
                          focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800
                          rounded">
                    Live Demo →
                </a>
            }
        </div>
    </div>
</article>

@code {
    /// <summary>
    /// Project title - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>
    /// Project description - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = "";

    /// <summary>
    /// URL to project screenshot image - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string ImageUrl { get; set; } = "";

    /// <summary>
    /// Alt text for the project screenshot - required for accessibility.
    /// </summary>
    [Parameter, EditorRequired]
    public string ImageAlt { get; set; } = "";

    /// <summary>
    /// URL to GitHub repository - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string GitHubUrl { get; set; } = "";

    /// <summary>
    /// Optional URL to live demo. When provided, shows "Live Demo" link.
    /// </summary>
    [Parameter]
    public string? DemoUrl { get; set; }

    /// <summary>
    /// List of technologies used in the project - required.
    /// </summary>
    [Parameter, EditorRequired]
    public IEnumerable<string> Technologies { get; set; } = Array.Empty<string>();
}
