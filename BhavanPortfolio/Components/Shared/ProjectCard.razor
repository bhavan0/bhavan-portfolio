<article class="card-modern overflow-hidden group h-full flex flex-col">
    @* Project Image *@
    <div class="aspect-video overflow-hidden bg-neutral-800 relative">
        <img src="@ImageUrl"
             alt="@ImageAlt"
             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>

    @* Project Content *@
    <div class="p-6 flex flex-col flex-1">
        <h3 class="text-xl font-semibold text-black dark:text-white group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors">
            @Title
        </h3>
        <p class="text-gray-600 dark:text-gray-400 mt-3 line-clamp-3 text-sm leading-relaxed flex-1">
            @Description
        </p>

        @* Technology Tags *@
        <div class="flex flex-wrap gap-2 mt-4">
            @foreach (var tech in Technologies)
            {
                <span class="rounded-full px-3 py-1 text-xs font-medium
                            bg-indigo-500/10 dark:bg-indigo-500/20
                            text-indigo-600 dark:text-indigo-300
                            border border-indigo-500/20 dark:border-indigo-500/30">
                    @tech
                </span>
            }
        </div>

        @* Action Links *@
        <div class="flex items-center gap-4 mt-5 pt-4 border-t border-gray-200/50 dark:border-white/10">
            <a href="@GitHubUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="flex items-center gap-2 text-gray-500 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400
                      transition-colors text-sm font-medium
                      focus:outline-none focus:ring-2 focus:ring-indigo-500
                      focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-neutral-900
                      rounded">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                </svg>
                Code
            </a>
            @if (!string.IsNullOrEmpty(DemoUrl))
            {
                <a href="@DemoUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex items-center gap-2 text-gray-500 dark:text-gray-400 hover:text-indigo-500 dark:hover:text-indigo-400
                          transition-colors text-sm font-medium
                          focus:outline-none focus:ring-2 focus:ring-indigo-500
                          focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-neutral-900
                          rounded">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Live Demo
                </a>
            }
        </div>
    </div>
</article>

@code {
    /// <summary>
    /// Project title - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>
    /// Project description - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = "";

    /// <summary>
    /// URL to project screenshot image - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string ImageUrl { get; set; } = "";

    /// <summary>
    /// Alt text for the project screenshot - required for accessibility.
    /// </summary>
    [Parameter, EditorRequired]
    public string ImageAlt { get; set; } = "";

    /// <summary>
    /// URL to GitHub repository - required.
    /// </summary>
    [Parameter, EditorRequired]
    public string GitHubUrl { get; set; } = "";

    /// <summary>
    /// Optional URL to live demo. When provided, shows "Live Demo" link.
    /// </summary>
    [Parameter]
    public string? DemoUrl { get; set; }

    /// <summary>
    /// List of technologies used in the project - required.
    /// </summary>
    [Parameter, EditorRequired]
    public IEnumerable<string> Technologies { get; set; } = Array.Empty<string>();
}
