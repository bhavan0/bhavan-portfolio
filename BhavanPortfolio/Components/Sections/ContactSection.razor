@* ContactSection Component - Contact information and social links *@
<section id="contact"
         class="py-24 md:py-32 relative overflow-hidden bg-white dark:bg-black"
         aria-labelledby="contact-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-grid opacity-30 dark:opacity-50" aria-hidden="true"></div>
    <div class="orb orb-purple w-96 h-96 -bottom-48 left-1/4 opacity-30" aria-hidden="true"></div>
    <div class="orb orb-blue w-72 h-72 top-20 -right-36 opacity-20" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 md:px-6 relative z-10">
        <div class="text-center max-w-2xl mx-auto">
            @* Section Header *@
            <div class="mb-8 reveal">
                <p class="text-sm font-medium tracking-widest uppercase text-indigo-500 dark:text-indigo-400 mb-3">
                    Let's connect
                </p>
                <h2 id="contact-heading"
                    class="text-4xl md:text-5xl font-bold text-black dark:text-white">
                    Get In <span class="gradient-text-static">Touch</span>
                </h2>
            </div>

            <p class="text-gray-600 dark:text-gray-400 text-lg mb-12 reveal" style="animation-delay: 0.1s;">
                I'm always interested in hearing about new opportunities, collaborations,
                or just connecting with fellow developers. Feel free to reach out!
            </p>

            @* CTA Button *@
            <div class="mb-12 reveal" style="animation-delay: 0.2s;">
                <a href="mailto:bhavan.anand1997@gmail.com"
                   class="btn-primary inline-flex items-center justify-center min-h-[56px] px-10 py-4 rounded-full font-medium text-lg text-white
                          focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black
                          hover:shadow-lg hover:shadow-indigo-500/30 transition-all duration-300">
                    <span>Say Hello</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </a>
            </div>

            @* Social Links *@
            <div class="flex flex-wrap justify-center gap-4 reveal" style="animation-delay: 0.3s;">
                <a href="https://github.com/bhavan0"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex items-center gap-2 px-6 py-3 rounded-full
                          bg-neutral-100 dark:bg-neutral-800/50
                          border border-neutral-200 dark:border-neutral-700
                          text-gray-700 dark:text-gray-300
                          hover:border-indigo-500/50 hover:text-indigo-500 dark:hover:text-indigo-400
                          transition-all duration-300
                          focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                   aria-label="Visit Bhavan's GitHub profile">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                    GitHub
                </a>

                <a href="https://www.linkedin.com/in/bhavan-anand"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="flex items-center gap-2 px-6 py-3 rounded-full
                          bg-neutral-100 dark:bg-neutral-800/50
                          border border-neutral-200 dark:border-neutral-700
                          text-gray-700 dark:text-gray-300
                          hover:border-indigo-500/50 hover:text-indigo-500 dark:hover:text-indigo-400
                          transition-all duration-300
                          focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                   aria-label="Visit Bhavan's LinkedIn profile">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                    LinkedIn
                </a>

                <a href="mailto:bhavan.anand1997@gmail.com"
                   class="flex items-center gap-2 px-6 py-3 rounded-full
                          bg-neutral-100 dark:bg-neutral-800/50
                          border border-neutral-200 dark:border-neutral-700
                          text-gray-700 dark:text-gray-300
                          hover:border-indigo-500/50 hover:text-indigo-500 dark:hover:text-indigo-400
                          transition-all duration-300
                          focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                   aria-label="Send email to Bhavan">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Email
                </a>
            </div>
        </div>
    </div>
</section>
