@* ContactSection Component - Contact information and social links *@
<section id="contact"
         class="py-20 md:py-32 bg-white dark:bg-black"
         aria-labelledby="contact-heading">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
        <h2 id="contact-heading"
            class="text-3xl md:text-4xl font-semibold text-black dark:text-white mb-4">
            Get In Touch
        </h2>

        <p class="text-gray-600 dark:text-gray-400 text-lg mb-8 max-w-2xl">
            I'm always interested in hearing about new opportunities, collaborations,
            or just connecting with fellow developers. Feel free to reach out!
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-4">
            <SocialLink LinkType="SocialLink.SocialLinkType.Email"
                        Label="Email Me"
                        Url="mailto:bhavan@example.com"
                        AriaLabel="Send email to Bhavan" />

            <SocialLink LinkType="SocialLink.SocialLinkType.LinkedIn"
                        Label="LinkedIn"
                        Url="https://linkedin.com/in/bhavan"
                        AriaLabel="Visit Bhavan's LinkedIn profile" />

            <SocialLink LinkType="SocialLink.SocialLinkType.GitHub"
                        Label="GitHub"
                        Url="https://github.com/bhavan0"
                        AriaLabel="Visit Bhavan's GitHub profile" />
        </div>
    </div>
</section>
