@inject IScrollService ScrollService

<section id="hero"
         class="min-h-screen flex items-center justify-center relative overflow-hidden bg-white dark:bg-black"
         aria-labelledby="hero-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-grid opacity-50 dark:opacity-100" aria-hidden="true"></div>

    @* Gradient Orbs *@
    <div class="orb orb-purple w-96 h-96 -top-48 -left-48 animate-pulse-slow" aria-hidden="true"></div>
    <div class="orb orb-blue w-80 h-80 top-1/3 -right-40 animate-pulse-slow" style="animation-delay: 1s;" aria-hidden="true"></div>
    <div class="orb orb-pink w-64 h-64 bottom-20 left-1/4 animate-pulse-slow" style="animation-delay: 2s;" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 md:px-6 text-center relative z-10">
        @* Greeting *@
        <p class="text-sm md:text-base font-medium tracking-widest uppercase text-indigo-400 dark:text-indigo-400 mb-4 reveal">
            Hello, I'm
        </p>

        @* Name with Gradient Animation *@
        <h1 id="hero-heading" class="text-6xl md:text-8xl lg:text-9xl font-bold gradient-text mb-6 reveal" style="animation-delay: 0.1s;">
            Bhavan
        </h1>

        @* Role with Subtle Animation *@
        <div class="flex items-center justify-center gap-3 mb-8 reveal" style="animation-delay: 0.2s;">
            <span class="h-px w-8 bg-gradient-to-r from-transparent to-indigo-500"></span>
            <p class="text-xl md:text-2xl lg:text-3xl font-light tracking-wide text-gray-600 dark:text-gray-300">
                Engineering Manager
            </p>
            <span class="h-px w-8 bg-gradient-to-l from-transparent to-indigo-500"></span>
        </div>

        @* Intro Text *@
        <p id="hero-intro" class="text-base md:text-lg lg:text-xl text-gray-600 dark:text-gray-400 leading-relaxed max-w-3xl mx-auto mb-10 reveal" style="animation-delay: 0.3s;">
            Engineering Manager with <span class="text-indigo-500 dark:text-indigo-400 font-medium">7+ years</span> of experience building scalable enterprise applications. Proven track record of leading engineering teams and developing AI-powered solutions. Combining technical depth with strong leadership to deliver products that drive real business outcomes.
        </p>

        @* CTA Buttons *@
        <div class="flex flex-col sm:flex-row gap-4 justify-center reveal" style="animation-delay: 0.4s;">
            <a href="/assets/Bhavan_Anand_Resume.pdf"
               download="Bhavan_Anand_Resume.pdf"
               class="btn-primary inline-flex items-center justify-center min-h-[48px] px-8 py-3 rounded-full font-medium text-white
                      focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black
                      hover:shadow-lg hover:shadow-indigo-500/30 transition-all duration-300"
               aria-label="Download resume as PDF file">
                <span>Download Resume</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
            </a>
            <button @onclick="ScrollToProjects"
                    class="btn-outline inline-flex items-center justify-center min-h-[48px] px-8 py-3 rounded-full font-medium
                           focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-black
                           transition-all duration-300"
                    aria-label="Scroll to projects section">
                View Projects
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </button>
        </div>
    </div>
</section>

@code {
    private async Task ScrollToProjects()
    {
        await ScrollService.ScrollToSectionAsync("projects");
    }
}
