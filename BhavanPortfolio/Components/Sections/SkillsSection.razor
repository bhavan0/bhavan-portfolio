<section id="skills" 
         class="py-20 md:py-32 bg-white dark:bg-black"
         aria-labelledby="skills-heading">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
        <h2 id="skills-heading" class="text-3xl md:text-4xl font-semibold text-black dark:text-white mb-8">
            Skills
        </h2>
        
        <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"
            aria-label="Technical skills">
            @foreach (var skill in Skills)
            {
                <SkillBadge SkillName="@skill" />
            }
        </ul>
    </div>
</section>

@code {
    // Skills from resume organized by category and priority
    // Total: 29 skills (comprehensive skill visibility)
    private readonly List<string> Skills = new()
    {
        // Languages (6)
        "C#",
        "Python",
        "TypeScript",
        "JavaScript",
        "HTML",
        "CSS",
        
        // Frameworks (8)
        ".NET Core",
        "Angular",
        "React",
        "Node.js",
        "Entity Framework",
        "Dapper",
        "NServiceBus",
        "ServiceStack",
        
        // Architecture (4)
        "Microservices",
        "Domain Driven Design",
        "Event Driven Architecture",
        "RESTful APIs",
        
        // Testing (4)
        "Playwright",
        "Cypress",
        "SpecFlow",
        "xUnit",
        
        // Databases (3)
        "MS SQL",
        "MongoDB",
        "PostgreSQL",
        
        // AI Tools (4)
        "Claude",
        "GitHub Copilot",
        "Cursor",
        "OpenAI Codex"
    };
}
