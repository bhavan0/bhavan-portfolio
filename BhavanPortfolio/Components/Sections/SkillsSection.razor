<section id="skills"
         class="py-24 md:py-32 relative overflow-hidden bg-white dark:bg-black"
         aria-labelledby="skills-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-grid opacity-30 dark:opacity-50" aria-hidden="true"></div>
    <div class="orb orb-blue w-72 h-72 -bottom-36 -right-36 opacity-20" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 md:px-6 relative z-10">
        @* Section Header *@
        <div class="text-center mb-16 reveal">
            <p class="text-sm font-medium tracking-widest uppercase text-indigo-500 dark:text-indigo-400 mb-3">
                What I work with
            </p>
            <h2 id="skills-heading" class="text-4xl md:text-5xl font-bold text-black dark:text-white">
                Technical <span class="gradient-text-static">Skills</span>
            </h2>
        </div>

        @* Skills Grid *@
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var category in SkillCategories)
            {
                <div class="reveal group p-6 rounded-2xl bg-gray-50/50 dark:bg-zinc-900/50 border border-gray-100 dark:border-zinc-800 hover:border-indigo-500/30 dark:hover:border-indigo-400/30 hover:bg-white dark:hover:bg-zinc-900 transition-all duration-300 backdrop-blur-sm">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="text-2xl filter grayscale group-hover:grayscale-0 transition-all duration-300">@category.Icon</span>
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
                            @category.Name
                        </h3>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var skill in category.Skills)
                        {
                            <SkillBadge SkillName="@skill" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SkillCategory(string Name, string Icon, List<string> Skills);

    private readonly List<SkillCategory> SkillCategories = new()
    {
        new("Languages", "💻", new() { "C#", "Python", "TypeScript", "JavaScript", "HTML", "CSS" }),
        new("Frameworks & Libraries", "🛠️", new() { ".NET Core", "Angular", "React", "Node.js", "Entity Framework", "Dapper", "NServiceBus", "ServiceStack" }),
        new("Architecture", "🏗️", new() { "Microservices", "Domain Driven Design", "Event Driven Architecture", "RESTful APIs" }),
        new("Testing", "🧪", new() { "Playwright", "Cypress", "SpecFlow", "xUnit" }),
        new("Databases", "💾", new() { "MS SQL", "MongoDB", "PostgreSQL" }),
        new("AI & Tools", "🤖", new() { "Antigravity", "Claude", "GitHub Copilot", "Cursor", "OpenAI Codex" })
    };
}
