<section id="skills"
         class="py-24 md:py-32 relative overflow-hidden bg-white dark:bg-black"
         aria-labelledby="skills-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-grid opacity-30 dark:opacity-50" aria-hidden="true"></div>
    <div class="orb orb-blue w-72 h-72 -bottom-36 -right-36 opacity-20" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 md:px-6 relative z-10">
        @* Section Header *@
        <div class="text-center mb-16 reveal">
            <p class="text-sm font-medium tracking-widest uppercase text-indigo-500 dark:text-indigo-400 mb-3">
                What I work with
            </p>
            <h2 id="skills-heading" class="text-4xl md:text-5xl font-bold text-black dark:text-white">
                Technical <span class="gradient-text-static">Skills</span>
            </h2>
        </div>

        @* Skills by Category *@
        <div class="space-y-12">
            @* Languages *@
            <div class="reveal" style="animation-delay: 0.1s;">
                <h3 id="skills-languages" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    Languages
                </h3>
                <div role="list" aria-labelledby="skills-languages" class="flex flex-wrap gap-3">
                    @foreach (var skill in Languages)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>

            @* Frameworks & Libraries *@
            <div class="reveal" style="animation-delay: 0.2s;">
                <h3 id="skills-frameworks" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    Frameworks & Libraries
                </h3>
                <div role="list" aria-labelledby="skills-frameworks" class="flex flex-wrap gap-3">
                    @foreach (var skill in Frameworks)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>

            @* Architecture & Patterns *@
            <div class="reveal" style="animation-delay: 0.3s;">
                <h3 id="skills-architecture" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    Architecture & Patterns
                </h3>
                <div role="list" aria-labelledby="skills-architecture" class="flex flex-wrap gap-3">
                    @foreach (var skill in Architecture)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>

            @* Testing *@
            <div class="reveal" style="animation-delay: 0.4s;">
                <h3 id="skills-testing" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    Testing
                </h3>
                <div role="list" aria-labelledby="skills-testing" class="flex flex-wrap gap-3">
                    @foreach (var skill in Testing)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>

            @* Databases *@
            <div class="reveal" style="animation-delay: 0.5s;">
                <h3 id="skills-databases" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    Databases
                </h3>
                <div role="list" aria-labelledby="skills-databases" class="flex flex-wrap gap-3">
                    @foreach (var skill in Databases)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>

            @* AI & Tools *@
            <div class="reveal" style="animation-delay: 0.6s;">
                <h3 id="skills-aitools" class="text-sm font-medium tracking-widest uppercase text-gray-500 dark:text-gray-400 mb-4">
                    AI & Tools
                </h3>
                <div role="list" aria-labelledby="skills-aitools" class="flex flex-wrap gap-3">
                    @foreach (var skill in AITools)
                    {
                        <SkillBadge SkillName="@skill" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    // Skills organized by category
    private readonly List<string> Languages = new()
    {
        "C#", "Python", "TypeScript", "JavaScript", "HTML", "CSS"
    };

    private readonly List<string> Frameworks = new()
    {
        ".NET Core", "Angular", "React", "Node.js", "Entity Framework", "Dapper", "NServiceBus", "ServiceStack"
    };

    private readonly List<string> Architecture = new()
    {
        "Microservices", "Domain Driven Design", "Event Driven Architecture", "RESTful APIs"
    };

    private readonly List<string> Testing = new()
    {
        "Playwright", "Cypress", "SpecFlow", "xUnit"
    };

    private readonly List<string> Databases = new()
    {
        "MS SQL", "MongoDB", "PostgreSQL"
    };

    private readonly List<string> AITools = new()
    {
        "Claude", "GitHub Copilot", "Cursor", "OpenAI Codex"
    };
}
