@* TimelineSection Component - Work Experience Timeline with Grouped Companies *@
@using BhavanPortfolio.Components.Shared

<section id="experience"
         class="py-24 md:py-32 relative overflow-hidden bg-white dark:bg-black"
         aria-labelledby="experience-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-grid opacity-30 dark:opacity-50" aria-hidden="true"></div>
    <div class="orb orb-purple w-72 h-72 top-20 -right-36 opacity-20" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-4 md:px-6 relative z-10">
        @* Section Header *@
        <div class="text-center mb-16 reveal">
            <p class="text-sm font-medium tracking-widest uppercase text-indigo-500 dark:text-indigo-400 mb-3">
                My journey
            </p>
            <h2 id="experience-heading"
                class="text-4xl md:text-5xl font-bold text-black dark:text-white mb-4">
                Work <span class="gradient-text-static">Experience</span>
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
                6+ years of building scalable enterprise applications across fintech, healthcare, and startup environments.
            </p>
        </div>

        @* Timeline with Grouped Companies *@
        <ul class="relative space-y-8" aria-label="Work experience timeline">
            @* Chatham Financial - Multiple Roles *@
            <div class="reveal">
                <CompanyGroup CompanyName="Chatham Financial Corp.">
                    <RoleItem Role="Lead Engineer | Senior Software Engineer"
                              Period="Nov 2024 - Present"
                              DateTimeValue="2024-11"
                              Location="Remote"
                              Highlights="@(new List<string> {
                                  "Leading engineering team and driving technical strategy for enterprise financial applications",
                                  "Delivered AI-powered platform features improving client workflows and decision-making",
                                  "Established cross-functional AI working group to explore innovative solutions",
                                  "Active member of hiring committee, shaping team growth and culture"
                              })" />
                    <RoleItem Role="Full Stack Software Developer"
                              Period="Feb 2023 - Nov 2024"
                              DateTimeValue="2023-02"
                              Location="PA, USA"
                              Highlights="@(new List<string> {
                                  "Modernized legacy applications to .NET Core and Angular, improving performance and maintainability",
                                  "Increased test coverage from 40% to 85% through comprehensive unit and integration testing",
                                  "Built end-to-end automation framework using Playwright, reducing manual QA time by 60%",
                                  "Designed and implemented event-driven systems using NServiceBus for async processing"
                              })" />
                </CompanyGroup>
            </div>

            @* My Money Karma - Single Role *@
            <div class="reveal" style="animation-delay: 0.1s;">
                <CompanyGroup CompanyName="My Money Karma Inc.">
                    <RoleItem Role="Full Stack Intern"
                              Period="Jun 2022 - Aug 2022"
                              DateTimeValue="2022-06"
                              Location="CA, USA"
                              Highlights="@(new List<string> {
                                  "Developed critical features serving thousands of users in personal finance platform",
                                  "Built reusable React component library improving development velocity",
                                  "Implemented automated E2E testing pipeline using Cypress"
                              })" />
                </CompanyGroup>
            </div>

            @* Eurofins IT Solutions - Multiple Roles *@
            <div class="reveal" style="animation-delay: 0.2s;">
                <CompanyGroup CompanyName="Eurofins IT Solutions Pvt Ltd">
                    <RoleItem Role="Software Engineer"
                              Period="Apr 2020 - Jul 2021"
                              DateTimeValue="2020-04"
                              Location="Bangalore, India"
                              Highlights="@(new List<string> {
                                  "Designed microservices architecture for laboratory information management systems",
                                  "Led migration from .NET Framework to .NET Core, reducing hosting costs by 40%",
                                  "Developed Angular UI components used across multiple product lines",
                                  "Created comprehensive test suites achieving 80%+ code coverage"
                              })" />
                    <RoleItem Role="Associate Software Engineer"
                              Period="Aug 2018 - Apr 2020"
                              DateTimeValue="2018-08"
                              Location="Bangalore, India"
                              Highlights="@(new List<string> {
                                  "Built web applications using C#, ASP.NET MVC, and SQL Server",
                                  "Collaborated with business analysts to translate requirements into technical solutions",
                                  "Optimized database queries improving application response times by 50%"
                              })" />
                </CompanyGroup>
            </div>
        </ul>
    </div>
</section>
