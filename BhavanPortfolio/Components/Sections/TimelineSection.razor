@* TimelineSection Component - Work Experience Timeline *@
@using static BhavanPortfolio.Components.Shared.TimelineItem

<section id="experience"
         class="py-20 md:py-32 bg-white dark:bg-black"
         aria-labelledby="experience-heading">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
        @* Section Header *@
        <div class="text-center mb-16">
            <h2 id="experience-heading"
                class="text-3xl md:text-4xl font-bold text-black dark:text-white mb-4">
                Work Experience
            </h2>
            <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
                6+ years of building scalable enterprise applications across fintech, healthcare, and startup environments.
            </p>
        </div>

        @* Timeline *@
        <ul class="relative" aria-label="Work experience timeline">
            @foreach (var entry in WorkExperience)
            {
                <TimelineItem Period="@entry.Period"
                              DateTimeValue="@entry.DateTimeValue"
                              Role="@entry.Role"
                              Company="@entry.Company"
                              Location="@entry.Location"
                              Highlights="@entry.Highlights"
                              EntryType="TimelineEntryType.Work" />
            }
        </ul>
    </div>
</section>

