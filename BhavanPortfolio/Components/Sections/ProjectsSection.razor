<section id="projects"
         class="py-24 md:py-32 relative overflow-hidden bg-gray-50 dark:bg-neutral-950"
         aria-labelledby="projects-heading">
    @* Background Effects *@
    <div class="absolute inset-0 bg-dots opacity-30 dark:opacity-50" aria-hidden="true"></div>
    <div class="orb orb-purple w-80 h-80 top-20 -left-40 opacity-20" aria-hidden="true"></div>
    <div class="orb orb-pink w-64 h-64 bottom-40 -right-32 opacity-20" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-4 md:px-6 relative z-10">
        @* Section Header *@
        <div class="text-center mb-16 reveal">
            <p class="text-sm font-medium tracking-widest uppercase text-indigo-500 dark:text-indigo-400 mb-3">
                My recent work
            </p>
            <h2 id="projects-heading" class="text-4xl md:text-5xl font-bold text-black dark:text-white">
                Featured <span class="gradient-text-static">Projects</span>
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @{ var index = 0; }
            @foreach (var project in _projects)
            {
                <div class="reveal-scale" style="animation-delay: @(0.1 * index)s;">
                    <ProjectCard Title="@project.Title"
                                 Description="@project.Description"
                                 ImageUrl="@project.ImageUrl"
                                 ImageAlt="@project.ImageAlt"
                                 GitHubUrl="@project.GitHubUrl"
                                 DemoUrl="@project.DemoUrl"
                                 Technologies="@project.Technologies" />
                </div>
                index++;
            }
        </div>
    </div>
</section>

@code {
    // Project data showcasing variety in technologies and domains
    private readonly List<ProjectData> _projects = new()
    {
        new ProjectData
        {
            Title = "Bhavan Portfolio",
            Description = "Modern developer portfolio built with Blazor WebAssembly and Tailwind CSS. Features dark/light theme switching, smooth scroll navigation, and a responsive design optimized for mobile and desktop viewing.",
            ImageUrl = "assets/images/projects/placeholder.svg",
            ImageAlt = "Screenshot of Bhavan Portfolio website showing the hero section with dark theme",
            GitHubUrl = "https://github.com/bananand/bhavan",
            DemoUrl = "https://bananand.github.io/bhavan",
            Technologies = new[] { "Blazor", ".NET", "Tailwind CSS", "GitHub Pages" }
        },
        new ProjectData
        {
            Title = "Enterprise API Gateway",
            Description = "High-performance REST API gateway built with .NET 8 and Azure Functions. Implements authentication, rate limiting, request validation, and comprehensive logging with Application Insights integration.",
            ImageUrl = "assets/images/projects/placeholder.svg",
            ImageAlt = "Architecture diagram showing API Gateway components and data flow",
            GitHubUrl = "https://github.com/bananand/api-gateway",
            Technologies = new[] { "C#", ".NET 8", "Azure Functions", "Redis", "SQL Server" }
        },
        new ProjectData
        {
            Title = "ML Document Classifier",
            Description = "Machine learning pipeline for automatic document classification using natural language processing. Achieves 95%+ accuracy on enterprise document categorization with support for multiple languages.",
            ImageUrl = "assets/images/projects/placeholder.svg",
            ImageAlt = "Dashboard showing document classification results and accuracy metrics",
            GitHubUrl = "https://github.com/bananand/doc-classifier",
            DemoUrl = "https://doc-classifier-demo.azurewebsites.net",
            Technologies = new[] { "Python", "scikit-learn", "Azure ML", "FastAPI", "Docker" }
        }
