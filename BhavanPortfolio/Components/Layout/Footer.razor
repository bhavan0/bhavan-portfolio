@* Footer Component - Professional footer with attribution and links *@
<footer class="py-12 bg-gray-50 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800">
    <div class="max-w-6xl mx-auto px-4 md:px-6">
        <div class="flex flex-col items-center gap-6">
            @* Social Links *@
            <div class="flex flex-wrap justify-center gap-4">
                <SocialLink LinkType="SocialLink.SocialLinkType.GitHub"
                            Label="GitHub"
                            Url="https://github.com/bhavan0"
                            AriaLabel="Visit Bhavan's GitHub profile" />

                <SocialLink LinkType="SocialLink.SocialLinkType.LinkedIn"
                            Label="LinkedIn"
                            Url="https://linkedin.com/in/bhavan"
                            AriaLabel="Visit Bhavan's LinkedIn profile" />

                <SocialLink LinkType="SocialLink.SocialLinkType.Email"
                            Label="Email"
                            Url="mailto:bhavan@example.com"
                            AriaLabel="Send email to Bhavan" />
            </div>

            @* Built with Blazor Badge *@
            <div class="flex items-center gap-2">
                <a href="https://dotnet.microsoft.com/apps/aspnet/web-apps/blazor"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 px-4 py-2 min-h-[44px] rounded-full
                          bg-gray-200 dark:bg-gray-800
                          text-gray-700 dark:text-gray-300
                          hover:bg-gray-300 dark:hover:bg-gray-700
                          transition-colors text-sm font-medium
                          focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white
                          focus:ring-offset-2 focus:ring-offset-gray-50 dark:focus:ring-offset-gray-900">
                    <span aria-hidden="true">⚡</span>
                    Built with Blazor
                </a>
            </div>

            @* Source Code Link (FR27) *@
            <a href="https://github.com/bhavan0/bhavan-portfolio"
               target="_blank"
               rel="noopener noreferrer"
               class="inline-flex items-center min-h-[44px] px-4 py-2
                      text-sm text-gray-500 dark:text-gray-500
                      hover:text-gray-700 dark:hover:text-gray-300
                      transition-colors
                      focus:outline-none focus:ring-2 focus:ring-black dark:focus:ring-white
                      focus:ring-offset-2 focus:ring-offset-gray-50 dark:focus:ring-offset-gray-900
                      rounded">
                View Source Code →
            </a>

            @* Copyright Notice *@
            <p class="text-sm text-gray-500 dark:text-gray-500">
                © @DateTime.Now.Year Bhavan. All rights reserved.
            </p>
        </div>
    </div>
</footer>
